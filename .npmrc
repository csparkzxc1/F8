# Expo Dev Client + Metro work best with hoisted node_modules.
# pnpm's default symlink layout occasionally trips up native module
# resolution during EAS prebuild. Hoisted gives a flat tree like npm.
node-linker=hoisted

# Auto-install peer deps so library packages don't need every consumer
# to redeclare them. Default in pnpm 8+, kept explicit for clarity.
auto-install-peers=true

# Don't strict-resolve workspace transitive peers — saves install time
# on Expo's large dep graph.
strict-peer-dependencies=false
