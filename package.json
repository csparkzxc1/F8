{
  "name": "f8",
  "version": "0.1.0",
  "private": true,
  "description": "F8 — Film camera app series. f/8 and be there.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "eslint --fix \"packages/**/src/**/*.{ts,tsx}\" \"apps/**/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "seoul": "pnpm --filter f8-seoul start",
    "tokyo": "pnpm --filter f8-tokyo start",
    "wedding": "pnpm --filter f8-wedding start"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
